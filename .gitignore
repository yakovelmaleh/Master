# Hugging Face task runtime data belongs on cluster storage, never in a PR.
/Tasks/*hf-instability*/cluster_runs/
/Tasks/*hf-instability*/**/__pycache__/
/Tasks/*hf-instability*/**/.pytest_cache/
/Tasks/*hf-instability*/**/cache/
/Tasks/*hf-instability*/**/checkpoint/
/Tasks/*hf-instability*/**/checkpoints/
/Tasks/*hf-instability*/**/adapter/
/Tasks/*hf-instability*/**/*.safetensors
/Tasks/*hf-instability*/**/*.bin
/Tasks/*hf-instability*/**/*.pt
/Tasks/*hf-instability*/**/*.pth
/Tasks/*hf-instability*/**/*.onnx
/Tasks/*hf-instability*/**/*.gguf
/Tasks/*hf-instability*/**/*.npy
/Tasks/*hf-instability*/**/*.npz

# Code-smell source snapshots, detector binaries and fitted artifacts stay external.
/Tasks/*code-smell*/cluster_runs/
/Tasks/*code-smell*/**/__pycache__/
/Code_Smells_Detection/runtime/__pycache__/
/Code_Smells_Detection/runtime/tests/__pycache__/
/Tasks/*code-smell*/**/*.joblib
/Tasks/*code-smell*/**/*.npz
